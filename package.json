{
  "name": "functional-test-tool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Author, perform, and report accessibility functional tests",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-user-guide.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "marked": "^18.0.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maureendmccleary/functional-test-tool.git"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "testing",
    "wcag",
    "screen-reader"
  ]
}
